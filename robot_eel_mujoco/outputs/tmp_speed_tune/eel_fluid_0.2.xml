              <geom name="servo4_visual" type="mesh" mesh="servo4_mesh" contype="0" conaffinity="0" group="1" material="eel_mat"/>

              <body name="servo5" pos="-0.072 0 0">
                <geom name="servo5_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
                <inertial pos="-0.012049 -9.537e-08 -0.025445" mass="0.11015" fullinertia="3.4259e-05 6.2761e-05 5.9923e-05 -6.1969e-10 -1.0867e-07 -1.5471e-12"/>
                <joint name="servo5" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
                <geom name="servo5_collision" type="mesh" mesh="servo5_mesh" contype="2" conaffinity="1" group="0" rgba="1 0 0 1" fluidshape="ellipsoid"
                      fluidcoef="0.2 0.0 0.2 0.2 0.2"/>
                <geom name="servo5_visual" type="mesh" mesh="servo5_mesh" contype="0" conaffinity="0" group="1" material="eel_mat"/>

                <body name="servo6" pos="-0.072 -0.00005 0">
                  <geom name="servo6_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
                  <inertial pos="-0.014138 1.4332e-05 -0.025449" mass="0.11461" fullinertia="3.3039e-05 7.6484e-05 7.4549e-05 -1.9391e-07 -1.414e-07 -5.6905e-10"/>
                  <joint name="servo6" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
                  <geom name="servo6_collision" type="mesh" mesh="servo6_mesh" contype="2" conaffinity="1" group="0" rgba="1 0 0 1" fluidshape="ellipsoid"
                        fluidcoef="0.2 0.0 0.2 0.2 0.2"/>
                  <geom name="servo6_visual" type="mesh" mesh="servo6_mesh" contype="0" conaffinity="0" group="1" material="eel_mat"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position joint="servo1" kp="100"/>
    <position joint="servo2" kp="100"/>
    <position joint="servo3" kp="100"/>
    <position joint="servo4" kp="100"/>
    <position joint="servo5" kp="100"/>
    <position joint="servo6" kp="100"/>
  </actuator>
</mujoco>
