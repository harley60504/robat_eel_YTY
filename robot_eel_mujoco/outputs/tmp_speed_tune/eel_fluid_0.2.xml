            <geom name="servo3_visual" type="mesh" mesh="servo3_mesh" contype="0" conaffinity="0" group="1" material="eel_mat"/>

            <body name="servo4" pos="-0.072 0 0">
              <geom name="servo4_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
              <inertial pos="-0.0120487147742294 -9.53697419864633e-08 -0.0254453955715893" mass="0.110152499571834" fullinertia="3.42586243719868e-05 6.27609879607102e-05 5.99228972528301e-05 -6.1968780952349e-10 -1.08668371449204e-07 -1.54710052350768e-12"/>
              <joint name="servo4" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
              <geom name="servo4_collision" type="mesh" mesh="servo4_mesh" contype="2" conaffinity="1" group="0" rgba="1 0 0 1" fluidshape="ellipsoid"
