<mujoco model="eel_urdf">
  <compiler angle="radian" meshdir="eel_urdf/meshes"/>

  <option timestep="0.001" integrator="RK4" density="998" viscosity="0.001" gravity="0 0 -9.81"/>

  <visual>
    <global fovy="45" offwidth="1920" offheight="1080"/>
    <quality shadowsize="0"/>
    <rgba fog="0 0.5 0.8 1"/>
    <map fogstart="1" fogend="5"/>
  </visual>

  <asset>
    <mesh name="base_link_mesh" file="base_link.STL"/>
    <mesh name="servo1_mesh" file="servo1.STL"/>
    <mesh name="servo2_mesh" file="servo2.STL"/>
    <mesh name="servo3_mesh" file="servo3.STL"/>
    <mesh name="servo4_mesh" file="servo4.STL"/>
    <mesh name="servo5_mesh" file="servo5.STL"/>
    <mesh name="servo6_mesh" file="servo6.STL"/>
    <texture name="texplane" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2"
             type="2d" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
    <material name="matplane" reflectance="0.5" texture="texplane" texrepeat="4 4" texuniform="true"/>
    <material name="water_visual_mat" rgba="0 0.4 0.9 0.2" reflectance="0" shininess="0" specular="0"/>
    <material name="wall_brown_mat" rgba="0.25 0.18 0.10 1" reflectance="0.02" specular="0" shininess="0"/>
    <material name="eel_mat" rgba="0.79216 0.81961 0.93333 1" reflectance="0.2" specular="0.35" shininess="0.4"/>
    <material name="joint_marker_red" rgba="1 0 0 1" specular="0" shininess="0" reflectance="0"/>
  </asset>

  <contact>
    <exclude body1="base_link" body2="servo1"/>
    <exclude body1="servo1" body2="servo2"/>
    <exclude body1="servo2" body2="servo3"/>
    <exclude body1="servo3" body2="servo4"/>
    <exclude body1="servo4" body2="servo5"/>
    <exclude body1="servo5" body2="servo6"/>
  </contact>

  <worldbody>
    <include file="environment_2x8.xml"/>

    <body name="base_link" pos="-3.8 0 -0.02">
      <joint name="root_x" type="slide" pos="0 0 0" axis="1 0 0" limited="false" armature="0.01" damping="0.1"/>
      <joint name="root_y" type="slide" pos="0 0 0" axis="0 1 0" limited="false" armature="0.01" damping="0.1"/>
      <joint name="root_z_rot" type="hinge" pos="0 0 0" axis="0 0 1" limited="false" armature="0.01" damping="0.1"/>
      <inertial pos="0.060736 0 -0.0003316" mass="0.08594" fullinertia="4.4884e-05 0.00010101 9.7427e-05 9.7342e-21 -4.7953e-07 4.7279e-21"/>
      <geom name="base_link_collision" type="mesh" mesh="base_link_mesh" contype="2" conaffinity="1" group="0" rgba="1 0 0 1" fluidshape="ellipsoid"
            fluidcoef="0.2 0.0 0.2 0.2 0.2"/>
      <geom name="base_link_visual" type="mesh" mesh="base_link_mesh" contype="0" conaffinity="0" group="1" material="eel_mat"/>

      <body name="servo1" pos="-0.035 0 0.025433">
        <geom name="servo1_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
        <inertial pos="-0.012049 -9.537e-08 -0.025445" mass="0.11015" fullinertia="3.4259e-05 6.2761e-05 5.9923e-05 -6.1969e-10 -1.0867e-07 -1.5471e-12"/>
        <joint name="servo1" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
        <geom name="servo1_collision" type="mesh" mesh="servo1_mesh" contype="2" conaffinity="1" group="0" rgba="1 0 0 1" fluidshape="ellipsoid"
              fluidcoef="0.2 0.0 0.2 0.2 0.2"/>
        <geom name="servo1_visual" type="mesh" mesh="servo1_mesh" contype="0" conaffinity="0" group="1" material="eel_mat"/>

        <body name="servo2" pos="-0.072 0 0">
          <geom name="servo2_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
          <inertial pos="-0.012049 -9.537e-08 -0.025445" mass="0.11015" fullinertia="3.4259e-05 6.2761e-05 5.9923e-05 -6.1969e-10 -1.0867e-07 -1.5471e-12"/>
          <joint name="servo2" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
          <geom name="servo2_collision" type="mesh" mesh="servo2_mesh" contype="2" conaffinity="1" group="0" rgba="1 0 0 1" fluidshape="ellipsoid"
                fluidcoef="0.2 0.0 0.2 0.2 0.2"/>
          <geom name="servo2_visual" type="mesh" mesh="servo2_mesh" contype="0" conaffinity="0" group="1" material="eel_mat"/>

          <body name="servo3" pos="-0.072 0 0">
            <geom name="servo3_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
            <inertial pos="-0.012049 -9.537e-08 -0.025445" mass="0.11015" fullinertia="3.4259e-05 6.2761e-05 5.9923e-05 -6.1969e-10 -1.0867e-07 -1.5471e-12"/>
            <joint name="servo3" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
            <geom name="servo3_collision" type="mesh" mesh="servo3_mesh" contype="2" conaffinity="1" group="0" rgba="1 0 0 1" fluidshape="ellipsoid"
