<mujoco model="test2">
  <compiler angle="radian" meshdir="meshes/stl" />    <!-- inertiafromgeom="true" -->

  <option timestep="0.001" integrator="RK4" density="1000" viscosity="0.01" gravity="0 0 -9.81"/>
  
  <visual>
    <!-- 只留視角大小，不設定方向 -->
    <global fovy="45"  offwidth="1920" offheight="1080"/>
    <quality shadowsize="0"/>
    <!-- 水霧效果 OK -->
    <rgba fog="0 0.5 0.8 1"/>
    <map fogstart="1" fogend="5"/>
  </visual>
 <asset>
  <mesh name="base_link_visual" file="base_link_visual.stl"/>
  <mesh name="link1_visual"  file="link1_visual.stl"/>
  <mesh name="link2_visual"  file="link2_visual.stl"/>
  <mesh name="link3_visual"  file="link3_visual.stl"/>
  <mesh name="link4_visual"  file="link4_visual.stl"/>
  <mesh name="link5_visual"  file="link5_visual.stl"/>
  <mesh name="link6_visual"  file="link6_visual.stl"/>
  <texture name="texplane" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2" 
           type="2d" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>  
  <material name="matplane" reflectance="0.5" texture="texplane" texrepeat="4 4" texuniform="true"/>
  <material name="water_visual_mat" rgba="0 0.4 0.9 0.2" reflectance="0" shininess="0" specular="0"/>
  <material name="wall_brown_mat" rgba="0.25 0.18 0.10 1" reflectance="0.02" specular="0" shininess="0"/>
  <material name="eel_mat" rgba="0.55 0.6 0.6 1" reflectance="0.2" specular="0.35" shininess="0.4"/>
  <material name="joint_marker_red" rgba="1 0 0 1" specular="0" shininess="0" reflectance="0"/>
</asset>
<!-- ROBOR EEL BODY -->
  <worldbody>
    <!-- 1️⃣ 主光（Key light）：決定整體形體 -->
    <light directional="true"
    pos="0 0 5"
    dir="0 0 -1"
    diffuse="0.6 0.6 0.6"
    specular="0.15 0.15 0.15"/>
    <!-- 2️⃣ 補光（Fill light）：避免魚變灰 -->
    <light pos="2 1 1"
    diffuse="0.15 0.2 0.25"
    specular="0 0 0"/>
    <!-- 3️⃣ 輪廓光（Rim / Back light）：讓魚邊緣跳出來 -->
    <light pos="-2 0 1"
    diffuse="0.25 0.25 0.3"
    specular="0 0 0"/>

    <geom name="floor" pos="0 0 -0.5" size="2 2 0.1" type="plane" material="matplane" contype="1" conaffinity="1"/>
    <geom name="wall_front" type="box" pos="2 0 0" size="0.1 2 0.5" material="wall_brown_mat" contype="1" conaffinity="1"/>
    <geom name="wall_back"  type="box" pos="-2 0 0" size="0.1 2 0.5" rgba="0 0.5 0.8 0.2" contype="1" conaffinity="1"/>
    <geom name="wall_left"  type="box" pos="0 2 0" size="2 0.1 0.5" material="wall_brown_mat" contype="1" conaffinity="1"/>
    <geom name="wall_right" type="box" pos="0 -2 0" size="2 0.1 0.5" material="wall_brown_mat" contype="1" conaffinity="1" /> 
    <!-- <geom name="water_volume" type="box" pos="0 0 -0.25" size="4.95 1.95 0.27" material="water_visual_mat" contype="0" conaffinity="0" group="1"  /> -->
    <geom name="water_surface" type="plane" pos="0 0 0" size="1.95 1.95 0.01" material="water_visual_mat" contype="0" conaffinity="0" group="1"/>
    <geom name="center_line" type="capsule" pos="0 0 0" size="0.005 2" quat="0.7071 0 0.7071 0" 
      rgba="1 0 0 0.5" contype="0" conaffinity="0" group="1"/>
    <!-- head -->
    <body name="base_link" pos="-1.2 0 -0.02" >
      <!-- <geom name="test_sphere" type="sphere" size="0.05" pos="0.02 0 0" fluidshape="ellipsoid" rgba="0 1 0 0.5"/> -->
      <!-- <freejoint name="root"/> -->
      <joint name="root_x" type="slide" pos="0 0 0" axis="1 0 0" limited="false" armature="0.01" damping="0.1"/>
      <joint name="root_y" type="slide" pos="0 0 0" axis="0 1 0" limited="false" armature="0.01" damping="0.1"/>
      <joint name="root_z_rot" type="hinge" pos="0 0 0" axis="0 0 1" limited="false" armature="0.01" damping="0.1"/>
       <!-- 修正質量：從 1.3 kg 改成 0.3 kg (300g) -->
      <inertial pos="0.031 0 0.01725"  mass="0.275" diaginertia="0.00004 0.00004 0.00004"/>
      <geom name="base_link_collision" pos="-0.58754 0.02815 -0.00475" quat="0.707105 0 0 -0.707108"  type="mesh"  contype="2" conaffinity="1" group="0" rgba="1 0 0 1" mesh="base_link_visual" fluidshape="ellipsoid" 
      fluidcoef="0.5 0.0 0.5 0.5 0.5"/>
      <geom name="base_link_visual" pos="-0.58754 0.02815 -0.00475" quat="0.707105 0 0 -0.707108"  type="mesh" contype="0" material="eel_mat" conaffinity="0" group="1" mesh="base_link_visual"/>
    <!-- link1 -->
      <body name="link1" pos="-0.06425 0.00065 0.042"  >
        <geom name="link1_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
        <!-- 修正質量：從 0.15 kg 改成 0.08 kg (80g) -->
        <inertial pos="-0.0275 0 -0.025" quat="0.5 0.5 0.5 0.5" mass="0.08"  diaginertia="0.000015 0.000015 1e-05"/>
        <joint name="link1_joint" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
        <geom name="link1_collision" pos="-0.52329 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh"  group="0" contype="2" conaffinity="1" rgba="1 0 0 1"   mesh="link1_visual" fluidshape="ellipsoid" 
      fluidcoef="0.5 0.0 0.5 0.5 0.5"/>
        <geom name="link1_visual" pos="-0.52329 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh" contype="0" material="eel_mat" conaffinity="0" group="1"  density="0"   mesh="link1_visual"/>
     <!-- link2 -->
        <body name="link2" pos="-0.0747 0 0" >
          <geom name="link2_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
          <inertial pos="-0.0275 0 -0.025" quat="0.5 0.5 0.5 0.5" mass="0.08" diaginertia="0.000015 0.000015 1e-05"/>
          <joint name="link2_joint" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
          <geom name="link2_collision" pos="-0.44859 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh"  group="0" contype="2" conaffinity="1" rgba="1 0 0  1" mesh="link2_visual" fluidshape="ellipsoid" 
      fluidcoef="0.5 0.0 0.5 0.5 0.5"/>
          <geom name="link2_visual" pos="-0.44859 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh" contype="0" material="eel_mat" conaffinity="0" group="1" density="0"  mesh="link2_visual"/>
     <!-- link3 -->
          <body name="link3" pos="-0.0747 0 0" >
            <geom name="link3_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
            <inertial pos="-0.0275 0 -0.025" quat="0.5 0.5 0.5 0.5" mass="0.08" diaginertia="0.000015 0.000015 1e-05"/>
            <joint name="link3_joint" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
            <geom name="link3_collision" pos="-0.37389 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh"   group="0" contype="2" conaffinity="1" rgba="1 0   0 1" mesh="link3_visual" fluidshape="ellipsoid" 
      fluidcoef="0.5 0.0 0.5 0.5 0.5"/>
            <geom name="link3_visual" pos="-0.37389 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh" contype="0" material="eel_mat" conaffinity="0" group="1" density="0"  mesh="link3_visual"/>
      <!-- link4 -->
            <body name="link4" pos="-0.07332 3e-05 -0.00111" >
              <geom name="link4_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
              <inertial pos="-0.02888 -3e-05 -0.025" quat="0.5 0.5 0.5 0.5" mass="0.08" diaginertia="0.000015 0.000015 1e-05"/>
              <joint name="link4_joint" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
              <geom name="link4_collision" pos="-0.30057 0.02747 -0.04564" quat="0.707105 0 0 -0.707108" type="mesh"   group="0" contype="2" conaffinity="1"  rgba="1 0 0 1" mesh="link4_visual" fluidshape="ellipsoid" 
      fluidcoef="0.5 0.0 0.5 0.5 0.5"/>
              <geom name="link4_visual" pos="-0.30057 0.02747 -0.04564" quat="0.707105 0 0 -0.707108" type="mesh" contype="0" material="eel_mat" conaffinity="0" group="1" density="0"   mesh="link4_visual"/>
        <!-- link5 -->
              <body name="link5" pos="-0.07608 -3e-05 0.00111" >
                <geom name="link5_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
                <inertial pos="-0.0275 0 -0.025" quat="0.5 0.5 0.5 0.5" mass="0.08" diaginertia="0.000015 0.000015 1e-05"/>
                <joint name="link5_joint" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
                <geom name="link5_collision" pos="-0.22449 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh"  group="0"  contype="2" conaffinity="1"   rgba="1 0 0 1" mesh="link5_visual" fluidshape="ellipsoid" 
      fluidcoef="0.5 0.0 0.5 0.5 0.5"/>
                <geom name="link5_visual" pos="-0.22449 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh" contype="0" material="eel_mat" conaffinity="0" group="1"  density="0" mesh="link5_visual"/>
            <!-- link6 -->
                <body name="link6" pos="-0.0747 0 0" >
                  <geom name="link6_joint_marker" type="sphere" size="0.008" pos="0 0 0" material="joint_marker_red" contype="0" conaffinity="0" group="2"/>
                  <!-- 修正質量：從 0.16 kg 改成 0.1 kg (100g) -->
                  <inertial pos="-0.05018 0 -0.025" quat="0 0.707107 0 0.707107" mass="0.085" diaginertia="0.00012 0.00011 1e-05"/>
                  <joint name="link6_joint" pos="0 0 0" axis="0 0 1" range="-1.5 1.5" actuatorfrcrange="-10 10" armature="0.05" damping="1.5"/>
                  <geom name="link6_collision" pos="-0.14979 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh"  group="0" contype="2" conaffinity="1"  rgba="1 0 0 1" mesh="link6_visual" fluidshape="ellipsoid" 
      fluidcoef="0.5 0.0 0.5 0.5 0.5"/>
                  <geom name="link6_visual" pos="-0.14979 0.0275 -0.04675" quat="0.707105 0 0 -0.707108" type="mesh" contype="0" material="eel_mat" conaffinity="0" group="1"  density="0" mesh="link6_visual"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position joint="link1_joint" kp="100"/>
    <position joint="link2_joint" kp="100"/>
    <position joint="link3_joint" kp="100"/>
    <position joint="link4_joint" kp="100"/>
    <position joint="link5_joint" kp="100"/>
    <position joint="link6_joint" kp="100"/>
  </actuator>
</mujoco>